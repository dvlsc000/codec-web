# Public site URL (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://codec-info.hr

# --- Contact form email (Resend) ------------------------------------------
# Without RESEND_API_KEY, enquiries are only logged on the server (Vercel logs).
RESEND_API_KEY=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=info@codec-info.hr
# Sender — must be on a domain verified in Resend (e.g. codec-info.hr).
CONTACT_FROM_EMAIL=Codec web <web@codec-info.hr>

# --- Spam protection (optional) -------------------------------------------
# Cloudflare Turnstile. Set BOTH to enable; leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis — rate limit shared across all serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
